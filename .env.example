# MongoDB connection string (set one of: MONGO_URI, MONGODB_URI, DATABASE_URL)
MONGO_URI=
JWT_SECRET=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

GMAIL_USER=
GMAIL_PASS=

YOCO_SECRET_KEY=
# Yoco Public Key (frontend only; never put your secret key in the frontend)
YOCO_PUBLIC_KEY=
FRONTEND_URL=https://www.foundyourpet.co.za
BACKEND_URL=https://foundyourpet-backend.onrender.com
PORT=5001

# PayFast (Recurring Billing)
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
PAYFAST_PASSPHRASE=
PAYFAST_MODE=sandbox
PAYFAST_IP_ALLOWLIST=
PAYFAST_VALIDATE_WITH_SERVER=false
PAYFAST_AMOUNT_TOLERANCE_CENTS=5

# Subscriptions (PayFast recurring billing)
# Initial charge (today) and then recurring monthly amount thereafter.
SUBSCRIPTION_INITIAL_PRICE_ZAR=300
SUBSCRIPTION_RECURRING_PRICE_ZAR=50
# Back-compat (if SUBSCRIPTION_RECURRING_PRICE_ZAR is unset)
SUBSCRIPTION_MONTHLY_PRICE_ZAR=50
SUBSCRIPTION_GRACE_DAYS=3

# Optional: admin seed settings (used by `node seed.js`)
ADMIN_EMAIL=danielmommsen@hotmail.com
ADMIN_PASSWORD=
ADMIN_RESET_PASSWORD=false
ADMIN_UPDATE_PROFILE=false

# Push notifications (FCM)
# Service account JSON for firebase-admin (stringified JSON)
FIREBASE_SERVICE_ACCOUNT_JSON=

# Auto-hide a report after N flags (0 disables auto-hide)
REPORT_AUTOHIDE_FLAGS=0

# Web Push (VAPID)
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_CONTACT=mailto:support@foundyourpet.co.za
